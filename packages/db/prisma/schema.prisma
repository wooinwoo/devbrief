// Pulse DB schema
// pgvector extension 사용 (Article.embedding)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  imageUrl     String?
  createdAt    DateTime       @default(now())
  readingEvts  ReadingEvent[]
  chatSessions ChatSession[]
}

model Source {
  id        String         @id @default(cuid())
  provider  String // SourceProvider
  name      String
  feedUrl   String         @unique
  homepage  String?
  language  String         @default("en") // ko / en / mixed
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  articles  Article[]
}

model Article {
  id               String   @id @default(cuid())
  sourceId         String
  source           Source   @relation(fields: [sourceId], references: [id])
  title            String // 원문 제목
  titleKo          String? // 영문이면 Gemini 자동 번역 (한국어면 null)
  url              String   @unique
  author           String?
  publishedAt      DateTime
  summaryOneLine   String? // 한국어 1줄 요약 (영문이면 요약+번역 같이)
  summaryThreeLine String? // 한국어 3줄 요약
  tags             String[] @default([])
  language         String   @default("en") // ko / en / mixed — Gemini 가 추론
  fetchedAt        DateTime @default(now())

  // 썸네일: RSS enclosure / media:thumbnail / og:image 순으로 fallback
  imageUrl String?

  // pgvector embedding — Gemini text-embedding-004 기본 768 차원
  embedding  Unsupported("vector(768)")?

  readingEvts ReadingEvent[]

  @@index([publishedAt])
  @@index([sourceId, publishedAt])
}

model Conference {
  id              String    @id @default(cuid())
  name            String
  url             String    @unique
  startDate       DateTime
  endDate         DateTime?
  location        String
  topics          String[]
  description     String?
  imageUrl        String?
  brandColor      String? // oklch / hex — 브랜드 컬러
  youtubeChannelId String?

  // 자동 발견 / 승인 흐름
  // ACTIVE — 시드 또는 운영자 승인. 프론트 노출
  // PROPOSED — Discovery가 LLM NER로 추출한 후보. 운영자 검토 대기
  // REJECTED — 잘못된 후보 (스팸/중복). 다음 discovery에서 재제안 안 함
  status               String  @default("ACTIVE")
  discoveredFromArticleId String?
  discoveredAt         DateTime?

  createdAt       DateTime  @default(now())

  videos          Video[]

  @@index([startDate])
  @@index([status])
}

model Video {
  id           String      @id @default(cuid())
  videoId      String      @unique // YouTube video id
  title        String
  url          String
  channel      String // 채널명 표시용
  thumbnailUrl String
  durationSec  Int // 초 단위
  views        Int         @default(0)
  publishedAt  DateTime
  topics       String[]    @default([])
  description  String? // YouTube snippet.description (chapters 파싱 소스)

  // AI 분석 결과 (VideoAnalyzerService 가 채움)
  // chapterSource: 'official' (youtubei.js info.chapters)
  //              | 'description' (parseChapters 결과)
  //              | 'ai' (Gemini Flash 자동 생성)
  //              | null (둘 다 없고 분석 skip)
  chapters       Json? // [{ time: number, label: string }]
  chapterSource  String?
  summary        String? // Gemini 가 만든 3줄 요약
  analyzedAt     DateTime?

  conferenceId String?
  conference   Conference? @relation(fields: [conferenceId], references: [id])
  fetchedAt    DateTime    @default(now())

  @@index([publishedAt])
  @@index([conferenceId])
}

model ReadingEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  event     String // viewed / opened / saved / dismissed
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, articleId])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user / assistant / system
  content   String      @db.Text
  citations Json? // [{ articleId, snippet }]
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

/**
 * 매일 09:30 KST 자동 생성. 그 날 들어온 글 중 Gemini 가 선별한 5개 핵심.
 * date 는 yyyy-mm-dd 자정 기준.
 */
model DailyDigest {
  id          String   @id @default(cuid())
  date        DateTime @unique
  // [{ articleId, headline, takeaway }]
  items       Json
  intro       String? // 그 날 전반의 한 줄 요약 (선택)
  generatedAt DateTime @default(now())

  @@index([date])
}
