{
  "name": "@devbrief/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "wrangler pages dev --port 3001",
    "deploy:pages": "wrangler pages deploy --branch master"
  },
  "dependencies": {
    "@devbrief/shared": "workspace:*",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
