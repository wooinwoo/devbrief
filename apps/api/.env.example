# Devbrief API 환경 변수

# Postgres (pgvector extension 필수)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public

# Redis (BullMQ 큐)
REDIS_URL=redis://localhost:6379

# Gemini — 요약 / 임베딩(text-embedding-004, 768차원) / 챗봇 / 컨퍼런스 NER / 영상 분석
# 발급: https://aistudio.google.com (무료 티어 충분)
# 미설정 시: 요약은 무료 번역 폴백, 임베딩은 skip(의미검색 비활성)
GEMINI_API_KEY=AIza...

# 선택 — 사용할 Gemini 모델 (기본: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# YouTube Data API v3 — 영상 sync (선택. 없으면 manual seed에만 의존)
YOUTUBE_API_KEY=AIza...

# 선택 — 수집 시 소스당 최대 글 수 (기본값 코드 내 상한)
# INGEST_MAX_PER_SOURCE=20

# 어드민 쓰기 API 보호용 공유 시크릿
# ingestion/repos sync/videos sync 등 상태 변경(POST/PATCH/DELETE) 엔드포인트는
# x-admin-token 헤더가 이 값과 일치해야 한다. 미설정 시 해당 엔드포인트는 모두 거부된다.
ADMIN_API_TOKEN=

# 백엔드 서버
# 로컬은 API_PORT 사용. Railway 등 PaaS 는 PORT 를 자동 주입하며 코드가 PORT 를 우선한다
# (process.env.PORT ?? API_PORT ?? 4000). 배포 환경에서 PORT 를 수동 설정할 필요 없음.
API_PORT=4000
# CORS 허용 origin. 배포 시 Vercel web 공개 도메인으로 지정 (예: https://devbrief.vercel.app)
FRONTEND_URL=http://localhost:3000
