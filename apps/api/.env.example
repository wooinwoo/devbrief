# Devbrief API 환경 변수

# Postgres (pgvector extension 필수)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public

# Redis (BullMQ 큐)
REDIS_URL=redis://localhost:6379

# Gemini — 요약 / 임베딩(text-embedding-004, 768차원) / 챗봇 / 컨퍼런스 NER / 영상 분석
# 발급: https://aistudio.google.com (무료 티어 충분)
# 미설정 시: 요약은 무료 번역 폴백, 임베딩은 skip(의미검색 비활성)
GEMINI_API_KEY=AIza...

# 선택 — 사용할 Gemini 모델 (기본: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# YouTube Data API v3 — 영상 sync (선택. 없으면 manual seed에만 의존)
YOUTUBE_API_KEY=AIza...

# 선택 — 수집 시 소스당 최대 글 수 (기본값 코드 내 상한)
# INGEST_MAX_PER_SOURCE=20

# 백엔드 서버
API_PORT=4000
FRONTEND_URL=http://localhost:3000
