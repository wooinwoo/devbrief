# Pulse API 환경 변수

# Postgres (pgvector extension 필수)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public

# Redis (BullMQ 큐)
REDIS_URL=redis://localhost:6379

# Anthropic — 요약 (Haiku) / 챗봇 (Sonnet) / 컨퍼런스 NER (Haiku)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage — 임베딩 (voyage-3, 1024 차원)
VOYAGE_API_KEY=pa-...

# YouTube Data API v3 — 영상 sync (선택. 없으면 영상 sync skip)
YOUTUBE_API_KEY=AIza...
