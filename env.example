# Devbrief 환경 변수
# 사용 시 `cp env.example .env` 로 복사 후 값 채우기

# Postgres (로컬 docker-compose 또는 Neon)
# Neon: https://neon.tech 가입 → 프로젝트 생성 → connection string 복사
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public"

# Redis (로컬 docker-compose 또는 Upstash) — BullMQ 큐
# Upstash: https://upstash.com 가입 → Redis 생성
REDIS_URL="redis://localhost:6379"

# Gemini — 요약 / 임베딩(text-embedding-004) / 챗봇 / 컨퍼런스 NER / 영상 분석
# 발급: https://aistudio.google.com (무료 티어 충분)
# 미설정 시: 요약은 무료 번역 폴백, 임베딩은 skip(의미검색 비활성)
GEMINI_API_KEY=""

# 선택 — 사용할 Gemini 모델 (기본: gemini-2.5-flash-lite)
GEMINI_MODEL=""

# YouTube Data API v3 — 영상 sync (선택. 없으면 manual seed에만 의존)
YOUTUBE_API_KEY=""

# 선택 — 수집 시 소스당 최대 글 수
INGEST_MAX_PER_SOURCE=""

# 어드민 비밀번호 — 어드민 대시보드(/admin) 접근용
# 미설정 시 모든 어드민 로그인이 거부된다 (하드코딩 폴백 없음). 배포 시 반드시 지정.
ADMIN_PASSWORD=""

# 어드민 쓰기 API 보호용 공유 시크릿 (백엔드)
# 상태 변경(POST/PATCH/DELETE) 엔드포인트는 x-admin-token 헤더가 이 값과 일치해야 한다.
# 미설정 시 해당 엔드포인트는 모두 거부된다.
ADMIN_API_TOKEN=""

# 백엔드 (Nest)
API_PORT=4000
FRONTEND_URL="http://localhost:3000"

# 프론트엔드 (Next) — 웹이 호출할 API 베이스 URL (/api/v1 포함)
# 로컬은 비워두면 http://localhost:4000/api/v1 로 fallback. 배포 시 실제 API 도메인으로 지정.
NEXT_PUBLIC_API_BASE="http://localhost:4000/api/v1"

# 어드민 대시보드(/admin)가 백엔드 쓰기 API 호출 시 보내는 토큰.
# 백엔드 ADMIN_API_TOKEN 과 동일한 값으로 설정해야 어드민 UI 의 동기화/등록/삭제가 동작한다.
NEXT_PUBLIC_ADMIN_API_TOKEN=""
