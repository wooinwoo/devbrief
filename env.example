# 사용 시 `cp env.example .env` 로 복사 후 값 채우기

# Postgres (Neon 또는 로컬)
# Neon: https://neon.tech 가입 → 프로젝트 생성 → connection string 복사
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Redis (Upstash 또는 로컬)
# Upstash: https://upstash.com 가입 → Redis 생성 → REST URL+TOKEN 복사
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# Claude
# https://console.anthropic.com 에서 API 키 발급
ANTHROPIC_API_KEY=""

# Embedding (Voyage 또는 OpenAI)
# Voyage: https://voyageai.com (한국어 좋음)
VOYAGE_API_KEY=""

# Auth (NextAuth)
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# https://console.cloud.google.com 에서 OAuth 2.0 client 생성
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Backend (Nest)
API_PORT=4000
FRONTEND_URL="http://localhost:3000"

# Frontend (Next) — 웹이 호출할 API 베이스 URL (/api/v1 포함)
# 로컬은 비워두면 http://localhost:4000/api/v1 로 fallback. 배포 시 실제 API 도메인으로 지정.
NEXT_PUBLIC_API_BASE="http://localhost:4000/api/v1"
