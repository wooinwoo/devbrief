{
  "name": "devbrief",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @devbrief/db run generate",
    "db:migrate": "pnpm --filter @devbrief/db run migrate",
    "db:studio": "pnpm --filter @devbrief/db run studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "form-data@<4.0.6": ">=4.0.6",
      "undici@<7.28.0": ">=7.28.0 <8",
      "protobufjs@<=7.6.2": ">=7.6.3",
      "multer@<2.2.0": ">=2.2.0"
    }
  }
}
